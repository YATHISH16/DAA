import java.util.Arrays;
import java.util.Scanner;

public class Horspool2 {

    public static int[] preprocess(String pattern) {
    	int m = pattern.length();
    	int[] shiftTable = new int[256];
    	Arrays.fill(shiftTable, m);
    	for (int j = 0; j < m - 1; j++) {
        	shiftTable[pattern.charAt(j)] = m - 1 - j;
    	}
    	System.out.println("\n--- Shift Table ---");
    	for (int i = 0; i < 256; i++) {
        	if (shiftTable[i] != m) {
            	System.out.println("'" + (char) i + "' : " + shiftTable[i]);
        	}
    	}
    	System.out.println("Other Characters : " + m);
    	System.out.println("-------------------\n");
    
    	return shiftTable;
	}
static void search(String text, String pattern) {
        int n = text.length();
        int m = pattern.length();
        int alignments = 0;
        int comparisons = 0;
        int index = -1;

        if (m <= n && m > 0) {
            int[] shiftTable = preprocess(pattern);
            int i = m - 1; 

            while (i < n) {
                alignments++;
                int k = 0;
                
                while (k < m) {
                    comparisons++;
		    if (pattern.charAt(m - 1 - k) == text.charAt(i - k)) {
                        k++;
                    } else {
                        break;
                    }
                }

                if (k == m) {
                    index = i - m + 1;
                    break; 
                }
                
                i += shiftTable[text.charAt(i)];
            }
        }
        if (index != -1) {
            System.out.println("Pattern found at index: " + index);
        } else {
            System.out.println("Pattern not found.");
        }
        System.out.println("Total Alignments: " + alignments);
        System.out.println("Total Comparisons: " + comparisons);
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter text: ");
        String text = scanner.nextLine();

        System.out.print("Enter pattern: ");
        String pattern = scanner.nextLine();

        search(text, pattern);

        scanner.close();
    }
}

