import java.util.Arrays;
import java.util.Scanner;

public class MinHeapBuilder2 {

    public static void buildMinHeap(int[] arr) {
        int n = arr.length;
        for (int i = n / 2 - 1; i >= 0; i--) {
            minHeapify(arr, n, i);
        }
    }
    private static void minHeapify(int[] arr, int n, int i) {
        int smallest = i;
        int left = 2 * i + 1;
        int right = 2 * i + 2;

        if (left < n && arr[left] < arr[smallest]) smallest = left;
        if (right < n && arr[right] < arr[smallest]) smallest = right;

        if (smallest != i) {
            int temp = arr[i];
            arr[i] = arr[smallest];
            arr[smallest] = temp;
            minHeapify(arr, n, smallest);
        }
    }
    public static int extractMin(int[] arr, int n) {
        if (n <= 0) return 0;

        int minElement = arr[0];
        System.out.println("Deleted Min: " + minElement);
        arr[0] = arr[n - 1];
        int newSize = n - 1;
        minHeapify(arr, newSize, 0);

        return newSize;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of elements: ");
        int n = sc.nextInt();
        int[] arr = new int[n];

        System.out.println("Enter " + n + " elements:");
        for (int i = 0; i < n; i++) arr[i] = sc.nextInt();
        buildMinHeap(arr);
        System.out.println("\nInitial Min Heap: " + Arrays.toString(arr));
        System.out.println("\n--- Starting Deletion Process ---");
        int currentSize = n;
        while (currentSize > 0) {
            currentSize = extractMin(arr, currentSize);
            if (currentSize > 0) {
                int[] remaining = Arrays.copyOfRange(arr, 0, currentSize);
                System.out.println("Remaining Heap: " + Arrays.toString(remaining));
            } else {
                System.out.println("Heap is now empty.");
            }
        }
        sc.close();
    }
}
