import java.util.*;

public class NQueensQueue {

    public static void main(String[] args) {
        int n = 4; 
        
        List<List<Integer>> solutions = solveNQueens(n);
        
        if (solutions.isEmpty()) {
            System.out.println("No solution exists for N = " + n);
        } else {
            System.out.println("Found " + solutions.size() + " solutions:");
            for (List<Integer> solution : solutions) {
                printBoard(solution, n);
                System.out.println();
            }
        }
    }

    public static List<List<Integer>> solveNQueens(int n) {
        List<List<Integer>> result = new ArrayList<>();
        Queue<List<Integer>> queue = new LinkedList<>();
        queue.add(new ArrayList<>());

        while (!queue.isEmpty()) {
            List<Integer> currentBoard = queue.poll();
            int currentRow = currentBoard.size();
            if (currentRow == n) {
                result.add(currentBoard);
                continue;
            }
            for (int col = 0; col < n; col++) {
                if (isSafe(currentBoard, col)) {
                    List<Integer> nextBoard = new ArrayList<>(currentBoard);
                    nextBoard.add(col);
                    queue.add(nextBoard);
                }
            }
        }
        return result;
    }
    private static boolean isSafe(List<Integer> board, int col) {
        int row = board.size();
        for (int i = 0; i < row; i++) {
            int placedCol = board.get(i);
            if (placedCol == col || Math.abs(placedCol - col) == Math.abs(i - row)) {
                return false;
            }
        }
        return true;
    }

    private static void printBoard(List<Integer> board, int n) {
        for (int row = 0; row < n; row++) {
            int queenCol = board.get(row);
            for (int col = 0; col < n; col++) {
                System.out.print(col == queenCol ? " Q " : " . ");
            }
            System.out.println();
        }
    }
}
